# xAI API key — https://console.x.ai/ (never commit real values)
XAI_API_KEY=

# Optional overrides
XAI_API_BASE=https://api.x.ai/v1
GROK_MODEL=grok-4-1-fast-reasoning
HOST=127.0.0.1
PORT=9999
PUBLIC_URL=http://127.0.0.1:9999

# Set to 1 to answer without calling xAI (local/CI smoke)
GROK_A2A_DRY_RUN=0

# Shared inbound Bearer token. Required before any non-loopback HOST or PUBLIC_URL.
# When set, JSON-RPC requires: Authorization: Bearer <token>
# Agent Card stays public so clients can discover the scheme.
GROK_A2A_TOKEN=

# Optional: max JSON-RPC requests per client IP per 60s (0 = off)
GROK_A2A_RATE_LIMIT=0
