# xAI API key — https://console.x.ai/ (never commit real values)
XAI_API_KEY=

# Optional overrides
XAI_API_BASE=https://api.x.ai/v1
GROK_MODEL=grok-4-1-fast-reasoning
HOST=127.0.0.1
PORT=9999
PUBLIC_URL=http://127.0.0.1:9999

# Set to 1 to answer without calling xAI (local/CI smoke)
GROK_A2A_DRY_RUN=0
